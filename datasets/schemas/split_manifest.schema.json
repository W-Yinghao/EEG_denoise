{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "denoiseNet/split_manifest.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "dataset_id", "outer_fold_id", "train_participant_ids", "validation_participant_ids", "test_participant_ids", "support_context_ids", "query_context_ids", "frozen_at_utc"],
  "properties": {
    "schema_version": {"const": 1},
    "dataset_id": {"type": "string"},
    "outer_fold_id": {"type": "string"},
    "train_participant_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "validation_participant_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "test_participant_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "support_context_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "query_context_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "frozen_at_utc": {"type": "string", "minLength": 1},
    "notes": {"type": "array", "items": {"type": "string"}}
  }
}
