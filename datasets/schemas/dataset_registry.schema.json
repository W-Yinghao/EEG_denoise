{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "denoiseNet/dataset_registry.schema.json",
  "title": "Lightweight private-project dataset record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "dataset_id",
    "status",
    "path",
    "source",
    "version",
    "access",
    "sample_read",
    "checked_at_utc"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "dataset_id": {"type": "string", "minLength": 1},
    "status": {
      "enum": [
        "verified_available",
        "present_unverified",
        "partial",
        "missing",
        "restricted",
        "corrupt",
        "unknown"
      ]
    },
    "path": {"type": ["string", "null"]},
    "source": {"type": "string", "minLength": 1},
    "version": {"type": ["string", "null"]},
    "access": {"type": "string", "minLength": 1},
    "sample_read": {"type": "string", "minLength": 1},
    "notes": {"type": "array", "items": {"type": "string"}},
    "slurm_job_id": {"type": ["string", "null"], "pattern": "^[0-9]+$"},
    "checked_at_utc": {"type": "string", "minLength": 1}
  }
}
